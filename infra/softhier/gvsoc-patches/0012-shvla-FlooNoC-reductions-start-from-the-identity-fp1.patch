- 
++
 +    if (req->get_int(FlooNoc::REQ_MOMENTUM) == FlooNoc::MOMENTUM_DOWN)
 +    {
 +        if (check_target(cur_x,cur_y,src_x,src_y,row_m,col_m)) queue->push(FlooNoc::MOMENTUM_ZERO);
@@ -688,6 +695,18 @@ index 50cb4ac..ea9756f 100644
 +void Router::collective_generate(vp::IoReq * req, std::queue<int> * queue, int router_x, int router_y)
 +{
 +    int num_req = queue->size();
++    // [shvla] A reduction (types 2..7) folds every kid into the parent's data (process_collective_operations), so
++    // the parent must start from the identity. It held the iDMA read buffer (uninitialised) or, for a kid that forks
++    // again, a copy of it: each forking router added that garbage once to the result.
++    int coll_type = req->get_int(FlooNoc::REQ_COLL_TYPE);
++    if (coll_type >= 2 && coll_type <= 7)
++    {
++        uint16_t identity = 0;                          // ADD (2, 3, 4) and MAX UINT16 (5)
++        if (coll_type == 6) identity = 0x8000;          // MAX INT16: -32768
++        if (coll_type == 7) identity = 0xFC00;          // MAX FP16: -inf
++        uint16_t *d = (uint16_t *)req->get_data();
++        for (uint32_t i = 0; i < req->get_size() / sizeof(uint16_t); ++i) d[i] = identity;
++    }
 +    for (int i = 0; i < num_req; ++i)
 +    {
 +        int momentum = queue->front();
@@ -742,7 +761,7 @@ index 50cb4ac..ea9756f 100644
  
  void Router::grant(vp::IoReq *req)
  {
-@@ -241,23 +486,34 @@ void Router::grant(vp::IoReq *req)
+@@ -241,23 +498,34 @@ void Router::grant(vp::IoReq *req)
  
