@@ -88,7 +88,9 @@ index 668a863..5146e08 100644
 +
 +    if (exponent <= 0) {
 +        if (exponent < -10) return sign;   // too small
-+        mantissa = (floatBits.parts.mantissa | 0x800000) >> (1 - exponent);
++        // [shvla] fp16 subnormal: 24-bit significand >> (14 - exponent) leaves the 10-bit mantissa. Upstream shifted
++        // by (1 - exponent), so the extra 13 bits spilled into the exponent and sign of the result.
++        mantissa = (floatBits.parts.mantissa | 0x800000) >> (14 - exponent);
 +        return sign | mantissa;
 +    } else if (exponent >= 0x1F) {
 +        return sign | 0x7C00;  // overflow to infinity
@@ -101,6 +103,11 @@ index 668a863..5146e08 100644
 +    FloatBits floatBits;
 +    floatBits.parts.sign = (value >> 15) & 0x1;
 +    int32_t exponent = (value >> 10) & 0x1F;
++    // [shvla] fp16 subnormals (exponent 0, mantissa != 0) are m * 2^-24; upstream read them as float denormals (~0).
++    if (exponent == 0 && (value & 0x3FF)) {
++        float m = (float)(value & 0x3FF) * 5.9604644775390625e-08f;
++        return (value & 0x8000) ? -m : m;
++    }
 +    floatBits.parts.exponent = (exponent == 0) ? 0 : exponent + 127 - 15;
 +    floatBits.parts.mantissa = (value & 0x3FF) << 13;
 +    return floatBits.f;
@@ -418,7 +425,7 @@ index 4124c25..08e15ad 100644
  
