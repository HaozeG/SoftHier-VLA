From: Haoze <90812991+HaozeG@users.noreply.github.com>
Date: Wed, 11 Nov 2026 15:49:41 +0100
Subject: [PATCH 08/10] [shvla] RedMulE model: float_to_fp16 IEEE
 round-to-nearest-even (SIMULATOR_NOTES #3)

Truncation rounded every accumulation step toward zero (768-term fp16 dot products came out ~10 % low); the hardware RedMulE rounds. Re-implementation of the author's gvsoc_redmule_fp16_rne.patch (the patch file itself was not available): the 24-bit significand is rounded with ties to even, normal and subnormal paths, carry propagates into the exponent. Host unit test (576 k cases) is bit-identical to numpy float32 -> float16.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 soft_hier/flex_cluster/light_redmule.cpp | 36 ++++++++++++++++--------
 1 file changed, 24 insertions(+), 12 deletions(-)

diff --git a/soft_hier/flex_cluster/light_redmule.cpp b/soft_hier/flex_cluster/light_redmule.cpp
index 9f12cd7..b9b4bdd 100644
--- a/soft_hier/flex_cluster/light_redmule.cpp
+++ b/soft_hier/flex_cluster/light_redmule.cpp
@@ -1244,30 +1244,42 @@ void matmul_int16(int16_t * z, int16_t * y, int16_t * x, int16_t * w, uint16_t m
 }
 
 
-// Convert float to FP16 (half-precision), truncating (round toward zero).
-// fp16 subnormals (|v| < 2^-14, 2^-24 granularity) are encoded with the
-// 24-bit significand shifted right by (14 - exponent); the result is at most
-// 0x3FF there, so it never reaches the exponent / sign bits.
+// Convert float to FP16 (half-precision), IEEE round-to-nearest-even
+// (the hardware RedMulE rounds; truncation made long dot products come out low,
+// SIMULATOR_NOTES #3). fp16 subnormals (|v| < 2^-14, 2^-24 granularity) take the
+// 24-bit significand shifted right by (14 - exponent). A rounding carry propagates
+// naturally: 0x3FF -> next exponent, max subnormal -> min normal, 65520 -> inf.
 fp16 float_to_fp16(float value) {
     FloatBits floatBits;
     floatBits.f = value;
 
     uint16_t sign = floatBits.parts.sign << 15;
     int32_t exponent = floatBits.parts.exponent - 127 + 15; // adjust bias from 127 to 15
-    uint32_t mantissa = floatBits.parts.mantissa >> 13;     // reduce to 10 bits
+    uint32_t man23 = floatBits.parts.mantissa;
+    uint32_t q;
+    uint32_t rem, half;
 
     if (floatBits.parts.exponent == 0xFF) {
         // inf stays inf, NaN stays a (quiet) NaN
-        return sign | 0x7C00 | (floatBits.parts.mantissa ? 0x200 : 0);
+        return sign | 0x7C00 | (man23 ? 0x200 : 0);
     }
-    if (exponent <= 0) {
-        if (exponent < -10) return sign;   // too small (< 2^-24)
-        mantissa = (floatBits.parts.mantissa | 0x800000) >> (14 - exponent);
-        return sign | (mantissa & 0x3FF);
-    } else if (exponent >= 0x1F) {
+    if (exponent >= 0x1F) {
         return sign | 0x7C00;  // overflow to infinity
     }
-    return sign | (exponent << 10) | mantissa;
+    if (exponent <= 0) {
+        if (exponent < -10) return sign;   // < 2^-25: rounds to zero (2^-25 itself ties to even = 0)
+        uint32_t sig = man23 | 0x800000;
+        uint32_t shift = 14 - exponent;    // 14 .. 24
+        q = sig >> shift;
+        rem = sig & ((1u << shift) - 1);
+        half = 1u << (shift - 1);
+    } else {
+        q = ((uint32_t)exponent << 10) | (man23 >> 13);
+        rem = man23 & 0x1FFF;
+        half = 0x1000;
+    }
+    if (rem > half || (rem == half && (q & 1))) q++;
+    return sign | q;
 }
 
 // Convert FP16 to float (exact: subnormals, inf and NaN included)
