      // Check if any action should be taken in the next cycle from the FSM handler
--    this->fsm_event.enqueue();
 +    this->transfer_regulation_event.enqueue();
 +    // Also re-arm the FSM: it must be woken when can_accept_burst() was false and the
 +    // regulation queue is empty, otherwise the current transfer never completes (hang).
-+    this->fsm_event.enqueue();
+     this->fsm_event.enqueue();
  }
  
