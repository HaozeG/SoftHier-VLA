  // no active transfer
  void IDmaBe::enqueue_transfer(IdmaTransfer *transfer)
  {
@@ -897,10 +897,20 @@ index 4e3a273..b82eab5 100644
  }
  
  
-@@ -85,6 +118,22 @@ bool IDmaBe::can_accept_transfer()
-     return this->current_transfer_size == 0;
- }
- 
+ bool IDmaBe::can_accept_transfer()
+ {
+-    // Only accept a new transfer if no transfer is on-going.
+-    return this->current_transfer_size == 0;
+-}
+-
++    // Only accept a new transfer if no transfer is on-going and none is waiting in the regulation
++    // queue. The regulation handler forwards a queued transfer (and sets current_transfer_size) one
++    // cycle after enqueue_transfer(); in that window current_transfer_size is still 0, the middle-end
++    // pushes the next line, and the first transfer is lost (never issued, never acknowledged, the
++    // DMA wait hangs).
++    return this->current_transfer_size == 0 && this->regulation_queue.empty();
++}
++
 +#ifdef ENABLE_DMA_SIMPLE_COLLECTIVE_IMPLEMENTATION
 +uint64_t IDmaBe::get_collective_type()
