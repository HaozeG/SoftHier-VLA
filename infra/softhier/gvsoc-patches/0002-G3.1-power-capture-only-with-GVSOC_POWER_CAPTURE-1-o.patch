  {
      this->top = top;
      this->stop_event = new vp::Time_engine_stop_event(this->top);
-+    this->top->power.get_engine()->start_capture();
-+    this->power_capture_started = true;
++    // shvla (LOG G3.1): power capture only when GVSOC_POWER_CAPTURE=1. Always on, it grows the simulator
++    // past 13 GB within seconds (G3.1 rung 1: rung1a-gemm256).
++    const char *capture = std::getenv("GVSOC_POWER_CAPTURE");
++    if (capture != NULL && capture[0] == '1')
++    {
++        this->top->power.get_engine()->start_capture();
++        this->power_capture_started = true;
++    }
