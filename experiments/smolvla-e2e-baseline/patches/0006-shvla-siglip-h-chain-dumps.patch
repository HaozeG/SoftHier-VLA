+    # each followed by a global barrier (cluster 0 prints while the others would already run the next op in place).
+    # Tags OIN (%o as the o-proj GEMM reads it, after the group barrier), AOR (raw GEMM output), AOB (after add_bias),
+    # HCH (after the residual add) and WOI / BOI (the wo / bo parameter rows as they are just before use) share seed 203 = H's, so all sample the same (row, col) points.
+    h_dumps = int(os.environ.get("SHVLA_SIGLIP_H_DUMPS", "0") or 0) if test else 0
+    # SHVLA_SIGLIP_H_FULL=<n> (with H_DUMPS): n samples (large n ~ the whole tensor) of q / k / v / o at the end (QF KF VF OF) and of
+    # q / k / v after their gemm (QG, raw) and after add_bias (QB), same points per tensor (seed 440 + 2 + ord(letter))
+    h_full = int(os.environ.get("SHVLA_SIGLIP_H_FULL", "0") or 0) if h_dumps else 0
+    if h_dumps:
+        nsamples = max(nsamples, 16 * h_dumps)   # the end-of-program dumps (X..OUT) with many more points too
