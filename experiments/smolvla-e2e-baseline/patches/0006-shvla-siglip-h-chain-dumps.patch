+                e.op("softhier.group_barrier {grid_x = 4 : i32, grid_y = 4 : i32}")
             e.op(f"softhier.add_bias %{dst}, %{W(bias)} -> %{dst} {{{cl}}} : {T[dst]}, {T[W(bias)]} -> {T[dst]}")
+            if h_full and L == 0:
+                e.op(f'softhier.dump_samples %{dst} {{seed = {sd} : i32, n = {h_full} : i32, tag = "{U}B"}} : {T[dst]}')
+                e.op("softhier.group_barrier {grid_x = 4 : i32, grid_y = 4 : i32}")
         mark(f"qkv{L}")
         if fused_attention:
             e.op(f"softhier.attention %q, %k, %v -> %o {{scale = {1 / dh ** 0.5!r} : f32, heads = {heads} : i32, "
@@ -154,9 +172,25 @@ def emit(seq: int, d: int, ff: int, heads: int, layers: int = 1, cluster: int =
                 e.op(f"softhier.gemm %s{L}_{hd}, %v{L}_{hd} into %o{L}_{hd} {{fmt = \"fp16\", {pv}, {hc}}} : {sh}, {vh}, {oh}")
         e.op("softhier.group_barrier {grid_x = 4 : i32, grid_y = 4 : i32}")
         mark(f"attn{L}")
+
+        def hdump(tag, nm):   # opt-in inline dump + barrier (layer 0)
+            if h_dumps and L == 0:
+                nm = W(nm[:-1]) if nm in ("wo_", "bo_") else nm   # "wo_" / "bo_": this layer's parameter
+                e.op(f'softhier.dump_samples %{nm} {{seed = 203 : i32, n = {h_dumps} : i32, tag = "{tag}"}} : {T[nm]}')
+                e.op("softhier.group_barrier {grid_x = 4 : i32, grid_y = 4 : i32}")
+        hdump("OIN", "o")
+        hdump("WOI", "wo_")
+        hdump("BOI", "bo_")
         e.op(f"softhier.gemm %o, %{W('wo')} into %ao {{fmt = \"fp16\", {proj}, {cl}}} : {T['o']}, {T[W('wo')]}, {T['ao']}")
+        hdump("AOR", "ao")
+        if h_dumps and L == 0 and os.environ.get("SHVLA_SIGLIP_H_REGEMM"):   # run the o-proj gemm a second time into %ao
+            e.op(f"softhier.gemm %o, %{W('wo')} into %ao {{fmt = \"fp16\", {proj}, {cl}}} : {T['o']}, {T[W('wo')]}, {T['ao']}")
+            hdump("OIN2", "o")   # %o as the second gemm read it (it was complete by then if OIN2 passes and OIN did not)
+            hdump("AOR2", "ao")
         e.op(f"softhier.add_bias %ao, %{W('bo')} -> %ao {{{cl}}} : {T['ao']}, {T[W('bo')]} -> {T['ao']}")
+        hdump("AOB", "ao")
         e.op(f"softhier.add %{xin}, %ao -> %h {{{cl}}} : {T[xin]}, {T['ao']} -> {T['h']}")
+        hdump("HCH", "h")
         e.op(f"softhier.layernorm %h, %{W('g2')}, %{W('be2')} -> %ln2 {{eps = 1.0e-6 : f32, {cl}}} : {T['h']}, {T[W('g2')]}, {T[W('be2')]} -> {T['ln2']}")
         e.op(f"softhier.gemm %ln2, %{W('w1')} into %f1 {{fmt = \"fp16\", {fc1}, {cl}}} : {T['ln2']}, {T[W('w1')]}, {T['f1']}")
         e.op(f"softhier.add_bias %f1, %{W('b1')} -> %f1 {{{cl}}} : {T['f1']}, {T[W('b1')]} -> {T['f1']}")
@@ -176,6 +210,16 @@ def emit(seq: int, d: int, ff: int, heads: int, layers: int = 1, cluster: int =
             else:
                 nm = tagmap[tag]
                 e.op(f'softhier.dump_samples %{nm} {{seed = {seeds[tag]} : i32, n = {nsamples} : i32, tag = "{tag}"}} : {T[nm]}')
+        if h_dumps:   # %o again at the end with H's sample points (the O dump above uses seed 202)
+            e.op(f'softhier.dump_samples %o {{seed = 203 : i32, n = {h_dumps} : i32, tag = "OEND"}} : {T["o"]}')
+        for tag, nm in (("QF", "q"), ("KF", "k"), ("VF", "v"), ("OF", "o")) if h_dumps and h_full else ():
+            e.op(f'softhier.dump_samples %{nm} {{seed = {440 + len(tag) + ord(tag[0])} : i32, n = {h_full} : i32, tag = "{tag}"}} : {T[nm]}')
+        if h_dumps and not fused_attention:   # per head: the o column slice (OH<h>) and the softmax output rows (PH<h>)
+            for hd in range(heads):
+                ov = e.view(f"ohd{hd}", "o", T["o"], seq, dh, d, hd * dh)
+                pv_ = e.view(f"phd{hd}", "sc", T["sc"], seq, seq, seq, hd * seq * seq)
+                e.op(f'softhier.dump_samples %ohd{hd} {{seed = {400 + hd} : i32, n = {min(h_dumps, 128)} : i32, tag = "OH{hd}"}} : {ov}')
+                e.op(f'softhier.dump_samples %phd{hd} {{seed = {420 + hd} : i32, n = {min(h_dumps, 128)} : i32, tag = "PH{hd}"}} : {pv_}')
     body = "\n".join(e.lines)
     return f"builtin.module {{\n  func.func @siglip_encoder() {{\n{body}\n    func.return\n  }}\n}}\n"
 
