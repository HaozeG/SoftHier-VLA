 from softhier_mlir.sim.preload import sentinel_array
 
-MODELS = Path(os.environ.get("SHVLA_SMOLVLA_DIR", "/app/models/smolvla_base"))
-VISION_NPZ = MODELS / "vision_s1024.npz"      # SigLIP weights in library layout + the full 1024-row position table
-VLM_NPZ = MODELS / "vlm_c1.npz"               # text tower + connector weights (fp16 library layout)
-EXPERT_NPZ = MODELS / "expert.npz"            # expert weights + time table (fp16 library layout)
+
+
+def models_dir() -> Path:
+    """Checkpoint folder, read from SHVLA_SMOLVLA_DIR on every call (not bound at import)."""
+    return Path(os.environ.get("SHVLA_SMOLVLA_DIR", "/app/models/smolvla_base"))
+
+
+def vision_npz() -> Path:
+    """SigLIP weights in library layout + the full 1024-row position table."""
+    return models_dir() / "vision_s1024.npz"
+
+
+def vlm_npz() -> Path:
+    """Text tower + connector weights (fp16 library layout)."""
+    return models_dir() / "vlm_c1.npz"
+
+
+def expert_npz() -> Path:
+    """Expert weights + time table (fp16 library layout)."""
+    return models_dir() / "expert.npz"
+
+
+# the emitters take parameters of the same names, which shadow the functions inside them
+_vision_npz, _vlm_npz, _expert_npz = vision_npz, vlm_npz, expert_npz
+
+
 D, FF, HEADS, VLAYERS, PATCH = V.D, V.FF, V.HEADS, V.LAYERS, V.PATCH
 PS = V.PIX_SCALE * V.PIX_SCALE                # 16 SigLIP tokens per image token
