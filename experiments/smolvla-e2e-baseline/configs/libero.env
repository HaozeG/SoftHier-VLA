# LIBERO configuration: lerobot/smolvla_libero, 2 cameras at 512x512 after resize-with-pad
# (1024 SigLIP tokens each, 177-token prefix, S_pad 256).
# Sourced by run.sh after infra/env.sh (so SHVLA_DATA is set). Plain shell, no side effects.

# --- checkpoint (run.sh libero fetch) ---
SHVLA_CKPT_ID="lerobot/smolvla_libero"
SHVLA_CKPT_REV="a24f1f380461b665158d52acd140152c79e8b36d"
export SHVLA_SMOLVLA_DIR="$SHVLA_DATA/smolvla_libero"

# --- golden reference (infra/lerobot/golden_ref.py libero mode, G2.4: libero_spatial task 0, seed 0, first frame) ---
SHVLA_GOLDEN_OBS="libero:libero_spatial:0:0"
SHVLA_GOLDEN="$SHVLA_DATA/golden/libero.npz"

# --- host prepare commands, in order (run.sh libero prepare) ---
# Each entry: "<softhier_mlir.frontend module> <arguments>", run as `python -m softhier_mlir.frontend.<module> ...`.
# D = $SHVLA_SMOLVLA_DIR, C = --ckpt $D/model.safetensors, R = $SHVLA_GOLDEN.
_D="$SHVLA_SMOLVLA_DIR"
_C="--ckpt $_D/model.safetensors"
_R="$SHVLA_GOLDEN"
SHVLA_PREPARE_STEPS=(
    "smolvla prepare $_C --seq 1024 --out $_D/vision_s1024.npz"
    "smolvla prepare-vlm $_C --cams 1 --out $_D/vlm_c1.npz"                   # connector weights read by emit_vision
    "smolvla prepare-vlm $_C --cams 2 --out $_D/vlm_c2.npz"                   # the 177-token prefix (G4a.2)
    "smolvla_expert prepare $_C --ref $_R --out $_D/expert.npz"               # needs the golden reference
    "smolvla_e2e prepare $_C --ref $_R --out $_D/e2e_c2_t1024.npz"            # needs the golden reference
)
SHVLA_PREPARE_OUT=(
    "$_D/vision_s1024.npz" "$_D/vlm_c1.npz" "$_D/vlm_c2.npz" "$_D/expert.npz" "$_D/e2e_c2_t1024.npz"
)
unset _D _C _R

# --- expected stage times, simulated ms: the G4a ESTIMATE (composed, LOG G4a.4), G4b was not run (owner decision, R1), so these stay the estimate ---
SHVLA_EXPECT_TOTAL_MS="479.1"
SHVLA_EXPECT_VISION_MS="351.8"
SHVLA_EXPECT_CONNECTOR_MS="0.53"
SHVLA_EXPECT_PREFIX_MS="33.0"
SHVLA_EXPECT_EXPERT_MS="93.8"

# Owner-approved exception only: raise the per-simulator-process limit (seconds). Default 7200 from infra/env.sh.
# SHVLA_SIM_TIMEOUT=
